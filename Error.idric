error_code MissingUserAuthBanner = -50
error_code AlgorithmUnsupported = -51
error_code MacFailure = -52
error_code HashInit = -53
error_code HashCalculation = -54
error_code StoreOverflow = -55

public export
error_from_code : Int → Maybe SSHError
error_from_code 0 = Just NoError
error_from_code (-1) = Just SocketNone
error_from_code (-2) = Just BannerReceive
error_from_code (-3) = Just BannerSend
