error_from_code (-44) = Just Encrypt
error_from_code (-45) = Just BadSocket
error_from_code (-46) = Just KnownHostsError
error_from_code (-47) = Just ChannelWindowFull
error_from_code (-48) = Just KeyFileAuthenticationFailed
