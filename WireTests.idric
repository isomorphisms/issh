module WireTests

import Data.Bits
import System
import Wire

fail : String → IO ()
fail name = do
  putStrLn ("FAIL " ++ name)
  exitFailure

pass : String → IO ()
pass name = putStrLn ("PASS " ++ name)

check : String → Bool → IO ()
check name True = pass name
check name False = fail name

main : IO ()
main = do
  check "u32 big endian"
    (decode_u32 (encode_u32 0x12345678) == Just (0x12345678, []))
  check "u64 big endian"
    (decode_u64 (encode_u64 0x0123456789abcdef) == Just (0x0123456789abcdef, []))
  check "boolean false"
    (decode_boolean [0] == Right (False, []))
  check "boolean true"
    (decode_boolean [1] == Right (True, []))
  check "SSH string"
    (case encode_string [65, 66, 67] of
       Left _ => False
       Right wire => decode_string wire == Right ([65, 66, 67], []))
  check "mpint sign prefix"
    (encode_mpint_bytes [0x80] == Right [0, 0, 0, 2, 0, 0x80])
